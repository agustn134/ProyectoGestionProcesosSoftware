pipeline {
    agent any

    tools {
        jdk 'JDK21'
        maven 'Maven3'
    }

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    parameters {
        booleanParam(name: 'ANALIZAR_SONAR', defaultValue: false,
                     description: 'Activar después de configurar el servidor SonarQube y su token en Jenkins.')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh 'git lfs install --local'
                sh 'git lfs pull'
            }
        }

        stage('Ver directorio') {
            steps {
                sh 'pwd'
                sh 'ls -la'
                sh 'test -f Ejercicio5Cliente/pom.xml'
            }
        }

        stage('Verificar versiones') {
            steps {
                sh 'java -version'
                sh 'mvn -version'
            }
        }

        stage('Compilar y probar') {
            steps {
                sh 'mvn -B -ntp -f Ejercicio5Cliente/pom.xml clean verify -Dtest=ProyectosClienteTests'
            }
            post {
                always {
                    junit testResults: 'Ejercicio5Cliente/target/surefire-reports/TEST-*.xml',
                          allowEmptyResults: false
                }
            }
        }

        stage('SonarQube') {
            when {
                expression { params.ANALIZAR_SONAR }
            }
            steps {
                withSonarQubeEnv('SonarQube') {
                    withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                    sh 'mvn -B -ntp -f Ejercicio5Cliente/pom.xml sonar:sonar -Dsonar.projectKey=ejercicio5-cliente -Dsonar.projectName=Ejercicio5Cliente'
                    }
                }
            }
        }

        stage('Guardar JAR') {
            steps {
                archiveArtifacts artifacts: 'Ejercicio5Cliente/target/*.jar, Ejercicio5Cliente/target/site/jacoco/**, Ejercicio5Cliente/target/surefire-reports/TEST-*.xml', fingerprint: true
            }
        }
    }
}
