pipeline {
    agent any
    tools { jdk 'JDK21'; maven 'Maven3' }
    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timeout(time: 45, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }
    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh 'git lfs install --local --skip-repo'
                sh 'git lfs pull'
            }
        }
        stage('Versiones y revision') {
            steps { sh 'java -version && mvn -version && git rev-parse HEAD' }
        }
        stage('Pruebas completas y cobertura de metodos') {
            steps { sh 'mvn -B -ntp -f Ejercicio5Cliente/pom.xml clean verify' }
            post { always { junit testResults: 'Ejercicio5Cliente/target/surefire-reports/TEST-*.xml', allowEmptyResults: false } }
        }
        stage('Seguridad fuente dependencias y secretos') {
            steps { sh 'sh ci/security_scan.sh Ejercicio5Cliente' }
        }
        stage('Analisis Sonar y puerta de calidad') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                        sh '''
                            set +e
                            mvn -B -ntp -f Ejercicio5Cliente/pom.xml sonar:sonar -Dsonar.projectKey=ejercicio5-cliente-parte2 -Dsonar.projectName=Ejercicio5Cliente-Parte2 -Dsonar.exclusions=**/target/**,**/practica-3/**,**/ci-reports/** -Dsonar.coverage.exclusions=**/*Application.java > ci-reports/Ejercicio5Cliente/sonar-scanner.log 2>&1
                            result=$?
                            cat ci-reports/Ejercicio5Cliente/sonar-scanner.log
                            exit "$result"
                        '''
                        sh 'python3 ci/sonar_gate.py --module Ejercicio5Cliente --project ejercicio5-cliente-parte2'
                    }
                }
            }
        }
    }
    post {
        always {
            archiveArtifacts artifacts: 'Ejercicio5Cliente/target/site/jacoco/**, Ejercicio5Cliente/target/surefire-reports/TEST-*.xml, ci-reports/Ejercicio5Cliente/**', allowEmptyArchive: true
        }
        success {
            archiveArtifacts artifacts: 'Ejercicio5Cliente/target/*.jar', fingerprint: true
        }
    }
}
